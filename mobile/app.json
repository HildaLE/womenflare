{
  "expo": {
    "name": "WomenFlare",
    "slug": "womenflare",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon-only.png",
    "scheme": "womenflare",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#f7f3ee"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cloudflare.womenflare",
      "buildNumber": "5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cloudflare.womenflare",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-only.png",
        "backgroundColor": "#24143d"
      }
    },
    "extra": {
      "eas": {
        "projectId": "7a090ecd-4109-4fbd-8d7b-3ae0c1810d53"
      }
    }
  }
}
