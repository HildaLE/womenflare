{
  "name": "@womenflare/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply womenflare --local",
    "db:migrate:remote": "wrangler d1 migrations apply womenflare --remote",
